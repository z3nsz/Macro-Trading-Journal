# Copy this file to .env and fill in real values. Never commit .env.
APP_NAME="Macro Trading Journal"
ENVIRONMENT=development

# PostgreSQL connection: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://macro_journal:CHANGE_ME@localhost:5432/macro_journal
# Separate database that the test suite wipes and rebuilds on every run.
TEST_DATABASE_URL=postgresql+psycopg://macro_journal:CHANGE_ME@localhost:5432/macro_journal_test

# Added in later milestones (placeholders only):
# FRED_API_KEY=your-fred-api-key-here
